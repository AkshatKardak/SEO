# ---------------------------------------------------------------------------
# SerpoAI — server environment example
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# ---------------------------------------------------------------------------

# --- Core infrastructure ---
# MongoDB connection string (either name works; MONGODB_URI takes precedence).
MONGODB_URI=
# Secret used to sign JWT auth tokens.
JWT_SECRET=
# Public URL of the frontend (used for CORS + email links).
CLIENT_URL=http://localhost:5173
# Port the API listens on (optional; defaults to 5000).
PORT=5000

# --- AI providers (configure at least ONE) ---
# Only these three providers are used, in this priority order:
#   Groq -> Gemini -> OpenRouter
# A provider with no key is simply reported disabled; it is never attempted.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- AI routing behaviour ---
# Preferred primary provider: groq | gemini | openrouter.
# Ignored (falls back to the first enabled provider) if that key is missing.
AI_PRIMARY_PROVIDER=groq
# Allow falling back to the next enabled provider on retryable errors
# (rate limits, 5xx, network/timeout). Set to false to use the primary only.
AI_FALLBACK_ENABLED=true
# Optional backoff (ms) before retrying after a 429. Leave blank for none.
AI_RETRY_BACKOFF_MS=
#
# NOTE: The model for each provider is set in code with a sensible default.
# You normally do NOT need to set a model here. To override, you may set the
# provider's own *_MODEL variable — but leaving them unset is recommended.

# --- Optional integrations ---
# Transactional email (analysis-complete notifications). Email is skipped if unset.
RESEND_API_KEY=
RESEND_FROM=
# Google PageSpeed Insights (richer performance data). Optional.
PAGESPEED_API_KEY=
# Google Custom Search (rank tracking). Optional; both required together.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
